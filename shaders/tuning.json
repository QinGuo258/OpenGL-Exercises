{
    // ======================================================================
    // 光照颜色 — 控制场景中太阳、月亮、环境光的基础色调
    // ======================================================================

    // 日光颜色 RGB — （暖黄）调大→正午更偏金黄，调小→偏冷白
    "dayLight":       [1.3, 1.15, 0.95],

    // 日落光颜色 RGB — （橙红）调大→黄昏更红更暴力，调小→黄昏偏灰
    "sunsetLight":    [1.0, 0.4, 0.1],

    // 月光颜色 RGB — （极暗冷蓝）调大→夜晚更亮/更蓝，调小→更深暗
    "moonLight":      [0.01, 0.02, 0.04],

    // 白昼环境光 RGB — （清透冷蓝）阴影区域补光，调大→暗面变亮偏蓝，调小→反差更强烈
    "dayAmbient":     [0.25, 0.35, 0.50],

    // 夜间环境光 RGB — （深邃蓝）调大→夜晚更可见，调小→纯黑剪影
    "nightAmbient":   [0.02, 0.02, 0.06],

    // 白天地平线色 RGB — （浅青蓝）视线水平方向看到的天空色，调 R→偏粉，调 B→更偏蓝
    "dayHorizon":     [0.55, 0.75, 0.95],

    // 白天天顶色 RGB — （深邃蓝）正上方天空色，调大 G→天顶偏绿/青
    "dayZenith":      [0.15, 0.35, 0.80],

    // 黄昏地平线色 RGB — （橙红）调大→日落时地平线更灿烂
    "sunsetHorizon":  [1.0, 0.45, 0.2],

    // 黄昏天顶色 RGB — （紫色）调 R→偏粉，调 B→偏深紫
    "sunsetZenith":   [0.3, 0.1, 0.35],

    // 夜景地平线色 RGB — （深灰蓝）夜晚远处地面方向的残余天色
    "nightHorizon":   [0.05, 0.05, 0.12],

    // 夜景天顶色 RGB — （近纯黑）调大→夜空不再全黑，保留微弱深蓝基调
    "nightZenith":    [0.0, 0.0, 0.02],

    // ======================================================================
    // 阴影映射 — 光源摄像机、柔和度、偏移
    // ======================================================================

    // 光源摄像机与玩家的距离（米），越大覆盖范围越大但精度越低
    "shadowLightDistance": 50.0,

    // 正交投影半边长（米），40 = 80×80m 阴影覆盖
    "shadowOrthoSize":     40.0,

    // 近裁剪面（米）
    "shadowNearPlane":     1.0,

    // 远裁剪面（米）
    "shadowFarPlane":      100.0,

    // ======================================================================
    // SSAO 屏幕空间环境光遮蔽
    // ======================================================================

    // 采样半径（米），越大遮蔽范围越广
    "ssaoRadius": 3.0,

    // 深度偏移，消除表面自阴影（米）
    "ssaoBias":   0.02,

    // ======================================================================
    // 点光源 — 火把/岩浆/灯笼的照射参数
    // ======================================================================

    // 最大照射距离（米），超出后完全无光
    "pointLightMaxRange":    12.0,

    // 线性衰减系数（1/d 项）
    "pointLightAttenLinear": 0.14,

    // 二次衰减系数（1/d² 项）
    "pointLightAttenQuad":   0.07,

    // 边缘淡出距离（米），范围末端的平滑过渡
    "pointLightEdgeFade":    4.0,

    // 点光源亮度倍率
    "pointLightIntensity":   0.8,

    // ======================================================================
    // 大气雾 — 距离雾的密度与颜色
    // ======================================================================

    // 晴天雾密度（极小 = 几乎通透）
    "fogDensityClear": 0.0025,

    // 雨天雾密度（浓雾）
    "fogDensityRain":  0.005,

    // 晴天雾颜色 RGB — （淡蓝）模拟大气散射
    "fogColorClear":   [0.6, 0.8, 0.95],

    // 雨天雾颜色 RGB — （阴灰）天空阴沉时雾色
    "fogColorRain":    [0.4, 0.45, 0.5],

    // ======================================================================
    // 体积云 — 光线步进参数
    // ======================================================================

    // 视线步进次数，越大云细节越丰富（吃性能）
    "cloudViewSteps":    16,

    // 光源步进次数（自阴影精度）
    "cloudLightSteps":   2,

    // 云层底部高度（米）
    "cloudMinHeight":    300.0,

    // 云层顶部高度（米），与底部的差 = 云层物理厚度
    "cloudMaxHeight":    550.0,

    // ======================================================================
    // 天气 — 降雨、风力过渡速度
    // ======================================================================

    // 降雨强度过渡速率（≈2s 完成切换）
    "rainTransitionSpeed": 0.2,

    // 风力基础速度
    "windBaseSpeed":       2.0,

    // 雨天风力附加速度倍率
    "windRainSpeed":       4.0,

    // 风力基础强度（植被摆动幅度）
    "windBaseStrength":    0.05,

    // 雨天风力附加强度
    "windRainStrength":    0.05,

    // 雨天整体画面压暗系数（0 = 不压暗，1 = 全黑）
    "rainOverallDarken":   0.3,

    // ======================================================================
    // 后处理 — Bloom 辉光、HDR 曝光、上帝光体积散射
    // ======================================================================

    // Bloom 混合强度 — 调大→光晕更显眼更梦幻；调小→回归清淡写实
    "bloomIntensity":       0.35,

    // HDR 曝光度 — 调大→整体画面更亮（亮部可能过曝）；调小→整体变暗压抑
    "exposure":             0.5,

    // 上帝光整体强度 — 调大→体积光柱更亮更明显；0 则完全消失
    "godrayWeight":         0.018,

    // 上帝光拉扯密度 — 调大→光柱向内延伸更长/更密；调小→光柱变短收敛
    "godrayDensity":        1.0,

    // 上帝光衰减速率 — 越接近 1.0 尾部拖得越长；越小尾部收得越快
    "godrayDecay":          0.93,

    // Bloom 高斯模糊迭代次数（3H+3V = 6）
    "bloomBlurIterations":  6,

    // HDR 合成饱和度增强（1.0 = 无变化）
    "saturation":           1.25,

    // ======================================================================
    // 屏幕空间反射 (SSR) — 水面/道具对周围环境的镜面倒影
    // ======================================================================

    // SSR 光线最大距离 (米) — 调大→反射更远的建筑和地形；调小→只反射近处物体
    "ssrMaxDistance":       30.0,

    // SSR 步进步数 — 调大→命中更精确不易漏检（略吃性能）；调小→步进变粗可能漏反射
    "ssrRaySteps":          40,

    // SSR 二分精炼次数 — 调大→命中点更精准；0 则跳过精炼
    "ssrRefinementSteps":   4,

    // ======================================================================
    // 材质 — 镜面高光的强度与锐度
    // ======================================================================

    // 镜面高光基础强度 — 调大→积水/手持道具高光更亮；0 则仅剩漫反射
    "specularStrength":     0.5,

    // 高光锐利度 — 调大→光斑更集中更小（镜面感）；调小→光斑散开柔和
    "shininess":            32.0,

    // ======================================================================
    // 摄像机 — FOV 视场角
    // ======================================================================

    // 默认 FOV — 调大→视野更广（鱼眼感）；调小→视野缩窄（望远镜感）
    "defaultFov":           45.0,

    // 疾跑 FOV — 调大→疾跑时速度感更强；设为与 defaultFov 相同则取消 FOV 变化
    "sprintFov":            55.0,

    // FOV 平滑过渡速率（越大越快）
    "fovInterpSpeed":       8.0,

    // ======================================================================
    // 玩家 — 移动与物理
    // ======================================================================

    // 行走速度（米/秒）
    "walkSpeed":     4.0,

    // 疾跑速度（米/秒）
    "sprintSpeed":   8.0,

    // 潜行速度（米/秒）
    "sneakSpeed":    2.0,

    // 进食时移动速度（米/秒）
    "eatSpeed":      1.6,

    // 跳跃初速度（米/秒）
    "jumpForce":     6.0,

    // 重力加速度（米/秒²）
    "gravity":       -19.6,

    // 最大生命值
    "playerMaxHP":   20,

    // 进食回复量（HP）
    "eatingHealAmount": 4,

    // 进食蓄力时间（秒）
    "eatingChargeTime": 1.5,

    // 受伤无敌时间（秒）
    "playerImmunityTime": 0.5,

    // ======================================================================
    // 战斗 — 伤害、击退、判定范围
    // ======================================================================

    // 攻击最大距离（米）
    "attackMaxRange":        3.5,

    // 剑伤害
    "swordDamage":           7,

    // 空手伤害
    "emptyHandDamage":       1,

    // 剑气 AOE 伤害（横扫）
    "sweepAoeDamage":        3,

    // 剑气 AOE 水平范围（米）
    "sweepAoeRange":         3.0,

    // 剑气 AOE 前方锥角（cos 值，0.707 = 90°）
    "sweepAoeCone":          0.707,

    // 击退水平力度
    "knockbackHorizontal":   5.0,

    // 击退垂直力度
    "knockbackVertical":     4.5,

    // 僵尸撕咬距离（米）
    "zombieBiteRange":       1.5,

    // 僵尸攻击冷却（秒）
    "zombieAttackCooldown":  1.5,

    // 僵尸撕咬伤害
    "zombieBiteDamage":      2,

    // 玩家被咬击退水平力度
    "playerKnockbackHorizontal": 5.0,

    // 玩家被咬击退垂直力度
    "playerKnockbackVertical":   3.5
}
