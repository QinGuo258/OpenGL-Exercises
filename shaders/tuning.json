{
    // ======================================================================
    // 光照颜色 — 控制场景中太阳、月亮、环境光的基础色调
    // ======================================================================

    // 日光颜色 RGB — （暖黄）调大→正午更偏金黄，调小→偏冷白
    "dayLight":       [1.3, 1.15, 0.95],

    // 日落光颜色 RGB — （橙红）调大→黄昏更红更暴力，调小→黄昏偏灰
    "sunsetLight":    [1.0, 0.4, 0.1],

    // 月光颜色 RGB — （极暗冷蓝）调大→夜晚更亮/更蓝，调小→更深暗
    "moonLight":      [0.01, 0.02, 0.04],

    // 白昼环境光 RGB — （清透冷蓝）阴影区域补光，调大→暗面变亮偏蓝，调小→反差更强烈
    "dayAmbient":     [0.25, 0.35, 0.50],

    // 夜间环境光 RGB — （深邃蓝）调大→夜晚更可见，调小→纯黑剪影
    "nightAmbient":   [0.02, 0.02, 0.06],

    // 白天地平线色 RGB — （浅青蓝）视线水平方向看到的天空色，调 R→偏粉，调 B→更偏蓝
    "dayHorizon":     [0.55, 0.75, 0.95],

    // 白天天顶色 RGB — （深邃蓝）正上方天空色，调大 G→天顶偏绿/青
    "dayZenith":      [0.15, 0.35, 0.80],

    // 黄昏地平线色 RGB — （橙红）调大→日落时地平线更灿烂
    "sunsetHorizon":  [1.0, 0.45, 0.2],

    // 黄昏天顶色 RGB — （紫色）调 R→偏粉，调 B→偏深紫
    "sunsetZenith":   [0.3, 0.1, 0.35],

    // 夜景地平线色 RGB — （深灰蓝）夜晚远处地面方向的残余天色
    "nightHorizon":   [0.05, 0.05, 0.12],

    // 夜景天顶色 RGB — （近纯黑）调大→夜空不再全黑，保留微弱深蓝基调
    "nightZenith":    [0.0, 0.0, 0.02],

    // ======================================================================
    // 后处理 — Bloom 辉光、HDR 曝光、上帝光体积散射
    // ======================================================================

    // Bloom 混合强度 — 调大→光晕更显眼更梦幻；调小→回归清淡写实
    "bloomIntensity":       0.35,

    // HDR 曝光度 — 调大→整体画面更亮（亮部可能过曝）；调小→整体变暗压抑
    "exposure":             0.5,

    // 上帝光整体强度 — 调大→体积光柱更亮更明显；0 则完全消失
    "godrayWeight":         0.018,

    // 上帝光拉扯密度 — 调大→光柱向内延伸更长/更密；调小→光柱变短收敛
    "godrayDensity":        1.0,

    // 上帝光衰减速率 — 越接近 1.0 尾部拖得越长；越小尾部收得越快
    "godrayDecay":          0.92,

    // ======================================================================
    // 屏幕空间反射 (SSR) — 水面/道具对周围环境的镜面倒影
    // ======================================================================

    // SSR 光线最大距离 (米) — 调大→反射更远的建筑和地形；调小→只反射近处物体
    "ssrMaxDistance":       30.0,

    // SSR 步进步数 — 调大→命中更精确不易漏检（略吃性能）；调小→步进变粗可能漏反射
    "ssrRaySteps":          40,

    // SSR 二分精炼次数 — 调大→命中点更精准；0 则跳过精炼
    "ssrRefinementSteps":   4,

    // ======================================================================
    // 材质 — 镜面高光的强度与锐度
    // ======================================================================

    // 镜面高光基础强度 — 调大→积水/手持道具高光更亮；0 则仅剩漫反射
    "specularStrength":     0.5,

    // 高光锐利度 — 调大→光斑更集中更小（镜面感）；调小→光斑散开柔和
    "shininess":            32.0,

    // ======================================================================
    // 摄像机 — FOV 视场角
    // ======================================================================

    // 默认 FOV — 调大→视野更广（鱼眼感）；调小→视野缩窄（望远镜感）
    "defaultFov":           45.0,

    // 疾跑 FOV — 调大→疾跑时速度感更强；设为与 defaultFov 相同则取消 FOV 变化
    "sprintFov":            55.0
}
